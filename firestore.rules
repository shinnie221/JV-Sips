rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Products collection: Allow read and write for POS and Product catalog
    match /products/{productId} {
      allow read, write: if true;
    }
    
    // Sales collection: Allow read and write for POS checkout and sales reports
    match /sales/{saleId} {
      allow read, write: if true;
    }
  }
}
