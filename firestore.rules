rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Products collection:
    // Anyone can read products to view the menu, but ONLY authenticated staff can add, edit, or delete
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Sales collection:
    // ONLY authenticated staff can record sales or read official store financial reports
    match /sales/{saleId} {
      allow read, write: if request.auth != null;
    }
  }
}
